{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "namespaceName": {
            "defaultValue": "s247-ext-servicebus",
            "type": "string",
            "metadata": {
                "description": "Service Bus namespace name (suffix added automatically for uniqueness)."
            }
        },
        "queueName": {
            "defaultValue": "applogs-queue",
            "type": "string"
        }
    },
    "variables": {
        "suffix": "[substring(toLower(uniqueString(resourceGroup().id, resourceGroup().location)),0,5)]",
        "namespace": "[concat(parameters('namespaceName'), '-', variables('suffix'))]"
    },
    "resources": [
        {
            "type": "Microsoft.ServiceBus/namespaces",
            "apiVersion": "2021-11-01",
            "name": "[variables('namespace')]",
            "location": "[resourceGroup().location]",
            "sku": {
                "name": "Standard",
                "tier": "Standard"
            },
            "properties": {}
        },
        {
            "type": "Microsoft.ServiceBus/namespaces/queues",
            "apiVersion": "2021-11-01",
            "name": "[concat(variables('namespace'), '/', parameters('queueName'))]",
            "properties": {
                "lockDuration": "PT1M",
                "maxDeliveryCount": 10,
                "defaultMessageTimeToLive": "P7D",
                "status": "Active"
            },
            "dependsOn": [
                "[resourceId('Microsoft.ServiceBus/namespaces', variables('namespace'))]"
            ]
        }
    ],
    "outputs": {
        "namespaceName": {
            "type": "string",
            "value": "[variables('namespace')]"
        },
        "queueName": {
            "type": "string",
            "value": "[parameters('queueName')]"
        }
    }
}

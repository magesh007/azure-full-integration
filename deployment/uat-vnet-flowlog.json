{
    "$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "networkWatcherName": {
            "defaultValue": "NetworkWatcher_eastus",
            "type": "string"
        },
        "flowLogName": {
            "defaultValue": "s247-vnet-flowlog",
            "type": "string"
        },
        "targetVNetId": {
            "defaultValue": "/subscriptions/d78d883f-6db7-4729-89b8-47b944b57ad0/resourceGroups/ananth_jp/providers/Microsoft.Network/virtualNetworks/s247-test-vnet",
            "type": "string"
        },
        "storageId": {
            "defaultValue": "/subscriptions/d78d883f-6db7-4729-89b8-47b944b57ad0/resourceGroups/Site24x7-VNetFlow-UAT/providers/Microsoft.Storage/storageAccounts/vnetflowstgnja2a",
            "type": "string"
        },
        "flowLogLocation": {
            "defaultValue": "eastus",
            "type": "string"
        }
    },
    "resources": [
        {
            "type": "Microsoft.Network/networkWatchers/flowLogs",
            "apiVersion": "2023-09-01",
            "name": "[concat(parameters('networkWatcherName'), '/', parameters('flowLogName'))]",
            "location": "[parameters('flowLogLocation')]",
            "properties": {
                "targetResourceId": "[parameters('targetVNetId')]",
                "storageId": "[parameters('storageId')]",
                "enabled": true,
                "retentionPolicy": {
                    "days": 7,
                    "enabled": true
                },
                "format": {
                    "type": "JSON",
                    "version": 2
                }
            }
        }
    ]
}